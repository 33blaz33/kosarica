<!-- TEMPLATE (replace your existing product-template with this one) -->
<template id="product-template">
  <div
    class="product-card bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow duration-200"
    data-id="">
    <div class="p-5">
      <div class="flex flex-col sm:flex-row gap-5">

        <!-- Image -->
        <div
          class="w-full sm:w-32 h-32 flex-shrink-0 bg-gray-50 rounded-lg border border-gray-100 flex items-center justify-center overflow-hidden relative">
          <img src="" alt=""
            class="product-img w-full h-full object-contain p-2 hover:scale-105 transition-transform duration-300" />
          <div class="product-img-placeholder absolute inset-0 flex items-center justify-center text-gray-300 hidden">
            <i class="fa-solid fa-image-slash text-2xl"></i>
          </div>
        </div>

        <!-- Content -->
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start">
            <div class="flex-1 pr-4 min-w-0">
              <div class="flex items-center gap-2 min-w-0">
                <span
                  class="store-badge bg-emerald-100 text-emerald-800 text-[10px] px-1.5 py-0.5 rounded font-medium uppercase tracking-wide">STORE</span>

                <a href="#" target="_blank"
                  class="product-name-link font-medium text-gray-800 truncate block max-w-full min-w-0" title="">
                  <span class="product-name">Name</span>
                </a>
              </div>
            </div>

            <div class="text-right flex-shrink-0 pl-2">
              <!-- TOTAL PRICE -->
              <div class="product-price font-bold text-gray-900">0.00 EUR</div>
              <div class="price-change text-xs font-medium flex items-center justify-end text-gray-500"></div>
            </div>
          </div>

          <div class="error-msg mt-2 p-2 bg-red-50 text-red-700 text-sm rounded flex items-start hidden">
            <i class="fa-solid fa-circle-exclamation mr-1.5 mt-0.5"></i> <span>Error</span>
          </div>

          <!-- Secondary List -->
          <div class="secondary-list"></div>

          <!-- Chart -->
          <div class="chart-container">
            <canvas class="price-chart"></canvas>
          </div>
        </div>
      </div>

      <!-- Add Comparison Form -->
      <div class="compare-form-container hidden mt-4 pt-4 border-t border-gray-100 animate-fade-in">
        <div class="p-3 bg-white rounded-lg border border-gray-200">
          <form class="form-add-compare flex flex-col sm:flex-row gap-2">
            <input type="url" placeholder="URL konkurenčnega izdelka (npr. Spar...)" required
              class="input-compare-url flex-1 text-sm p-2 border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 bg-white text-gray-900 focus:outline-none" />
            <div class="flex gap-2">
              <button type="submit"
                class="px-3 py-2 bg-blue-600 text-white rounded text-xs font-medium hover:bg-blue-700 whitespace-nowrap">Dodaj</button>
              <button type="button"
                class="btn-cancel-compare px-3 py-2 bg-gray-200 text-gray-700 rounded text-xs font-medium hover:bg-gray-300 whitespace-nowrap">Prekliči</button>
            </div>
          </form>
          <p class="compare-error text-xs text-red-600 mt-2 font-medium hidden"></p>
        </div>
      </div>

      <!-- Actions -->
      <div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-sm text-gray-500">
        <span class="last-checked text-xs">Posodobljeno: -</span>

        <div class="flex space-x-2">
          <button type="button"
            class="btn-toggle-compare flex items-center px-3 py-1.5 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors text-xs font-medium">
            <i class="fa-solid fa-code-compare mr-1.5"></i> Dodaj primerjavo
          </button>

          <button type="button"
            class="btn-refresh p-2 rounded-full bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors"
            title="Osveži ceno">
            <i class="fa-solid fa-arrows-rotate"></i>
          </button>

          <button type="button"
            class="btn-delete p-2 rounded-full bg-red-50 text-red-600 hover:bg-red-100 transition-colors"
            title="Odstrani izdelek">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
      </div>

    </div>
  </div>
</template>
