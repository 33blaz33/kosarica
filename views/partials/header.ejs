<header class="bg-white border-b border-gray-200 sticky top-0 z-10 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 no-underline">
      <div class="bg-emerald-100 p-2 rounded-lg">
        <i class="fa-solid fa-bag-shopping text-emerald-600 text-xl"></i>
      </div>
      <h1 class="text-xl font-bold text-gray-900 hidden sm:block m-0">Košarica</h1>
    </a>

    <div class="flex items-center gap-3">
      <% if (!user) { %>
        <a id="btn-login" href="/login"
          class="flex items-center px-3 py-2 text-sm font-medium rounded-md bg-green-50 text-green-700 hover:bg-green-100 transition-colors">
          <i class="fa-solid fa-sign-in mr-2"></i>
          <span class="hidden sm:inline">Prijava</span>
        </a>
      <% } else { %>
        <span class="text-sm text-gray-700">
          <span class="hidden sm:inline">Prijavljen kot:</span>
          <a  id="btn-profile" href="/profile">
          <span class="font-semibold"><%= user.fullName %></span>
          </a>
        </span>

        <form action="/api/logout" method="post" class="m-0">
          <button type="submit"
            class="flex items-center px-3 py-2 text-sm font-medium rounded-md bg-red-50 text-red-700 hover:bg-red-100 transition-colors">
            <i class="fa-solid fa-right-from-bracket mr-2"></i>
            <span class="hidden sm:inline">Odjava</span>
          </button>
        </form>
      <% } %>
    </div>
  </div>
</header>
