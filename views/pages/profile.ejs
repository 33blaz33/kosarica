<!doctype html>
<html lang="en">
<%- include("../partials/head", { title: "Profil" }) %>

    <body class="bg-gray-50 min-h-screen">

        <%- include("../partials/header") %>

            <main class="max-w-6xl mx-auto px-4 py-10">
                <div class="max-w-md mx-auto bg-white border border-gray-200 rounded-xl shadow-sm p-6">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="bg-emerald-600 text-white p-2 rounded-lg">
                            <i class="fa-solid fa-user text-lg"></i>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-gray-900">Profil</h2>
                            <p class="text-sm text-gray-500">Spremenite nastavitve profila</p>
                        </div>
                    </div>

                    <form id="profile-form" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Uporabniško ime</label>
                            <input id="input-username" name="username" type="text" disabled
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-400"
                                style="background-color: #CCCCCC80;">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Ime</label>
                            <input id="input-firstname" name="firstname" type="text" required
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-400">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Priimek</label>
                            <input id="input-lastname" name="lastname" type="text" required
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-400">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Novo geslo</label>
                            <input id="input-password" name="password" type="password"
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-400">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">E-mail</label>
                            <input id="input-email" name="email" type="text"
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-400">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Aktivno e-mail obveščanje o
                                znižanjih</label>
                            <input id="input-active-email" name="lastname" type="checkbox" class=""
                                style="accent-color: #059669;">
                        </div>

                        <button type="submit" id="btn-save"
                            class="w-full rounded-lg bg-emerald-600 text-white font-semibold py-2 hover:bg-emerald-700 transition-colors">
                            Shrani
                        </button>

                        <button type="button" id="btn-back"
                            class="w-full rounded-lg bg-gray-200 text-gray-800 font-semibold py-2 hover:bg-gray-300 transition-colors">
                            Nazaj
                        </button>


                        <p id="add-success" class="mt-2 text-sm text-emerald-700 hidden"></p>
                        <p id="add-error" class="mt-2 text-sm text-red-600 hidden"></p>

                    </form>
                </div>
            </main>

            <script src="/js/profile.js"></script>
    </body>

</html>