<!doctype html>
<html lang="sl">
<%- include("../partials/head", { title: "Košarica" }) %>

  <body class="bg-gray-50 pb-20" data-page="basket">
    <%- include("../partials/header") %>
      <%- include("../partials/nav", { active }) %>

        <main class="max-w-6xl mx-auto px-4 py-3">

          <% if (!user) { %>
            <!-- Empty State (unauthenticated) -->
            <div id="unauthenticated-state"
              class="text-center py-12 px-4 rounded-xl border-2 border-dashed border-gray-300 bg-gray-50">
              <i class="fa-solid fa-bag-shopping mx-auto text-5xl text-gray-300 mb-3 block"></i>
              <h3 class="text-lg font-medium text-gray-900">Za shranjevanje košarice se je potrebno prijaviti</h3>
            </div>
            <% } else { %>

              <div id="authenticated-state">
                <!-- Input Section -->
                <%- include("../partials/search-bar", {name: 'Dodaj nov izdelek' }) %>

                  <!-- Filter/Sort Bar -->
                  <div id="controls-bar" class="mb-3 hidden">
                    <div class="flex flex-wrap items-center gap-2">
                      <!-- Search (full width on mobile, grows on bigger screens) -->
                      <div class="relative w-full sm:flex-1 sm:min-w-[280px]">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                          <i class="fa-solid fa-magnifying-glass text-gray-400"></i>
                        </div>

                        <input type="text" id="name-input" placeholder="Iskanje po nazivu izdelka"
                          class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 focus:ring-1 focus:ring-emerald-500 focus:outline-none" />
                      </div>

                      <!-- Osveževanje in sortiranje -->
                      <div class="flex w-full sm:w-auto items-center justify-end gap-2">
                        <button id="btn-refresh-all"
                          class="flex items-center px-3 py-2 text-sm font-medium rounded-md bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors">
                          <i class="fa-solid fa-arrows-rotate mr-2"></i>
                          <span class="hidden sm:inline">Osveži vse</span>
                        </button>

                        <div class="hidden sm:block h-6 w-px bg-gray-300 mx-1"></div>

                        <div class="flex items-center space-x-2">
                          <span class="text-sm text-gray-500 whitespace-nowrap">
                            <i class="fa-solid fa-arrow-down-up mr-1"></i> Razvrsti po:
                          </span>

                          <select id="sort-select"
                            class="block pl-3 pr-8 py-1.5 text-sm border-gray-300 rounded-md border bg-white focus:outline-none focus:border-emerald-500">
                            <option value="date_desc">Zadnje dodano</option>
                            <option value="name_asc">Ime (A-Z)</option>
                            <option value="price_delta">Sprememba cene</option>
                          </select>
                        </div>
                      </div>
                    </div>
                  </div>


                  <!-- Product List -->
                  <div id="product-list" class="grid grid-cols-1 md:grid-cols-2 gap-3 items-start">
                    <!-- Products injected here -->
                  </div>

                  <!-- Empty State -->
                  <div id="empty-state"
                    class="hidden text-center py-12 px-4 rounded-xl border-2 border-dashed border-gray-300 bg-gray-50">
                    <i class="fa-solid fa-bag-shopping mx-auto text-5xl text-gray-300 mb-3 block"></i>
                    <h3 class="text-lg font-medium text-gray-900">Vaš seznam je prazen</h3>
                    <p class="mt-1 text-sm text-gray-500">Začnite z vnosom URL naslova izdelka zgoraj.</p>
                  </div>

              </div>

              <!-- Template for Product Card (Hidden) -->
              <%- include("../partials/product-template") %>

                <% } %>
        </main>

        <% if (user) { %>
          <script type="module" src="/js/basket.js"></script>
          <% } %>
  </body>

  <%- include("../partials/footer") %>

</html>